# docker-compose 环境变量（复制为 .env 使用；也可直接写进 config/config.yaml）
# multica（有目录映射时放 config/multica-home，见 README；无目录映射模式用下面的 TOKEN）
MDS_MULTICA_PROFILE=desktop-api.multica.ai
# 官方云留空；自部署实例填如 http://xxx.xxx.xxx.xx
MDS_MULTICA_SERVER_URL=
MDS_MULTICA_WORKSPACE_ID=
MDS_MULTICA_AGENT_ID=

# multica PAT token —— 仅「无宿主机目录映射」模式需要：
# 首次启动自动写入容器内 ~/.multica（named volume），之后可移除
MDS_MULTICA_TOKEN=

# 钉钉机器人（开放平台 -> 应用 -> 凭证与基础信息）
MDS_DINGTALK_CLIENT_ID=
MDS_DINGTALK_CLIENT_SECRET=

# 钉钉白名单（逗号分隔；无目录映射模式只能靠环境变量配白名单）
MDS_DINGTALK_ALLOWED_STAFF_IDS=
MDS_DINGTALK_ALLOWED_USER_IDS=
MDS_DINGTALK_ALLOWED_NICKS=

# REST API 鉴权（可选）
MDS_API_KEY=
